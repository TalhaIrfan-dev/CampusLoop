<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="CampusLoop — the student marketplace for buying, selling, exchanging and donating on campus.">
  <title>CampusLoop | A Greener Campus Together</title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>
  <%- include('../partials/navbar', {
    activePage: 'home',
    showLogin: true,
    showSignup: true,
    showCreateListing: false
}) %>

  <main>
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="container hero-grid">
        <div class="hero-copy">
          <span class="eyebrow">
            <span class="eyebrow-dot"></span>
            Made for campus life
          </span>

          <h1>Give good things<br><span>another loop.</span></h1>

          <p class="hero-text">
            Buy, sell, exchange, donate, and find the things you need — all within your university community.
          </p>

          <div class="hero-actions">
            <a class="btn btn-primary btn-large" href="/marketplace">
              Explore marketplace <span aria-hidden="true">→</span>
            </a>

            <a class="btn btn-outline btn-large" href="/add-listing">
              List an item
            </a>
          </div>

          <div class="hero-note">
            <span class="note-icon">↻</span>
            Spend less. Waste less. Share more.
          </div>
        </div>

        <div class="hero-art">
          <div class="art-circle art-circle-one"></div>
          <div class="art-circle art-circle-two"></div>

          <div class="hero-card hero-card-main">
            <div class="hero-card-top">
              <span class="mini-tag">Campus finds</span>
              <span class="heart">♡</span>
            </div>

            <div class="book-stack">
              <div class="book book-back"></div>
              <div class="book book-middle"></div>
              <div class="book book-front">
                <span>LEARN<br>GROW<br>REPEAT</span>
              </div>
            </div>

            <div class="hero-product-title">Your next great find</div>
            <div class="hero-product-sub">Pre-loved, ready for you.</div>
          </div>

          <div class="floating-pill pill-top">
            <span>✦</span> Student to student
          </div>

          <div class="floating-pill pill-bottom">
            <span>↗</span> Keep it in the loop
          </div>

          <div class="leaf-shape leaf-one"></div>
          <div class="leaf-shape leaf-two"></div>
        </div>
      </div>
    </section>

    <!-- Buy, Sell, Exchange, Donate -->
    <section class="stats-strip">
      <div class="container stats-grid">
        <div>
          <strong>Buy</strong>
          <span>Find useful campus essentials</span>
        </div>

        <div>
          <strong>Sell</strong>
          <span>Give your items a new home</span>
        </div>

        <div>
          <strong>Exchange</strong>
          <span>Swap what you have for what you need</span>
        </div>

        <div>
          <strong>Donate</strong>
          <span>Pass on something useful</span>
        </div>
      </div>
    </section>

    <!-- Categories Section -->
    <section class="section container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Explore the loop</span>
          <h2>What are you looking for?</h2>
        </div>

        <a class="text-link" href="/marketplace">
          View all categories <span>→</span>
        </a>
      </div>

      <div class="category-grid">
        <a class="category-card" href="/marketplace">
          <span class="category-icon icon-book">▤</span>
          <strong>Books</strong>
          <small>Textbooks & notes</small>
        </a>

        <a class="category-card" href="/marketplace">
          <span class="category-icon icon-tech">⌁</span>
          <strong>Electronics</strong>
          <small>Gadgets & accessories</small>
        </a>

        <a class="category-card" href="/marketplace">
          <span class="category-icon icon-study">✎</span>
          <strong>Study supplies</strong>
          <small>Everyday essentials</small>
        </a>

        <a class="category-card" href="/marketplace">
          <span class="category-icon icon-home">⌂</span>
          <strong>Hostel & home</strong>
          <small>Make your space yours</small>
        </a>
      </div>
    </section>

    <!-- Smart Delivery Feature -->
    <section class="feature-section">
      <div class="container feature-grid">
        <div class="feature-visual">
          <div class="delivery-orbit">
            <span class="orbit-dot"></span>
            <div class="delivery-box">↗</div>
            <span class="orbit-label label-one">Pickup</span>
            <span class="orbit-label label-two">Bike</span>
            <span class="orbit-label label-three">Van</span>
          </div>
        </div>

        <div class="feature-copy">
          <span class="eyebrow">A smarter way to move items</span>

          <h2>Right item.<br><span>Right delivery.</span></h2>

          <p>
            Our planned Smart Delivery Recommendation feature will consider item size, weight, fragility, distance, and urgency to suggest a suitable delivery option.
          </p>

          <a class="text-link" href="/marketplace">
            Explore the marketplace <span>→</span>
          </a>

          <p class="small-muted">
            Delivery recommendations will be simulated in this student project.
          </p>
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="cta-section container">
      <div class="cta-card">
        <div>
          <span class="eyebrow eyebrow-light">Your campus. Your community.</span>

          <h2>Have something useful<br>to pass along?</h2>

          <p>Put it back into the loop and help another student.</p>
        </div>

        <a class="btn btn-white btn-large" href="/add-listing">
          Create a listing <span>→</span>
        </a>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <%- include('../partials/footer', { showTagline: true }) %>
</body>
</html>