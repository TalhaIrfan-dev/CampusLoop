<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Listings | CampusLoop</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/navbar', { activePage: 'marketplace', showLogin: true, showSignup: false, showCreateListing: true }) %>
    <main class="container page-main">
        <div class="page-heading">
            <div>
                <span class="eyebrow">Your marketplace activity</span>
                <h1>My <span>listings.</span></h1>
                <p>View and manage the items you have shared with the campus.</p>
            </div>
            <a class="btn btn-primary" href="/add-listing">+ Create listing</a>
        </div>

        <% if (listings.length) { %>
            <div class="my-listings-grid">
                <% listings.forEach(listing => { %>
                    <article class="my-listing-card">
                        <a class="my-listing-image" href="/product-detail/<%= listing.listing_id %>">
                            <% if (listing.image_path) { %>
                                <img src="<%= listing.image_path %>" alt="<%= listing.title %>">
                            <% } else { %>
                                <span class="listing-image-placeholder" aria-hidden="true">♧</span>
                            <% } %>
                        </a>
                        <div class="my-listing-content">
                            <span class="product-category"><%= listing.category %> · <%= listing.listing_type %></span>
                            <h2><a href="/product-detail/<%= listing.listing_id %>"><%= listing.title %></a></h2>
                            <p class="my-listing-meta"><%= listing.condition %> ·
                                <%= listing.listing_type === 'sell' ? 'Rs. ' + Number(listing.price).toLocaleString('en-PK') : listing.listing_type === 'exchange' ? 'Exchange' : 'Free' %>
                            </p>
                            <span class="listing-status status-<%= listing.status %>"><%= listing.status %></span>
                            <div class="my-listing-actions">
                                <a class="btn btn-outline" href="/my-listings/<%= listing.listing_id %>/edit">Edit</a>
                                <form method="POST" action="/my-listings/<%= listing.listing_id %>/delete"
                                      onsubmit="return confirm('Are you sure you want to delete this listing?');">
                                    <button class="btn btn-danger" type="submit">Delete</button>
                                </form>
                            </div>
                        </div>
                    </article>
                <% }) %>
            </div>
        <% } else { %>
            <div class="market-empty-state">
                <div aria-hidden="true">＋</div>
                <h2>You have not listed anything yet</h2>
                <p>Create your first listing and share it with other students.</p>
                <a class="btn btn-primary" href="/add-listing">Create your first listing</a>
            </div>
        <% } %>
    </main>
    <%- include('../partials/footer', { showTagline: true }) %>
</body>
</html>
