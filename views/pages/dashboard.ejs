
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard | CampusLoop</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('../partials/navbar', {
        activePage: 'dashboard',
        showLogin: false,
        showSignup: false,
        showCreateListing: true
    }) %>

    <main class="container page-main">

        <!-- Dashboard Heading -->
        <div class="page-heading">
            <div>
                <span class="eyebrow">Your CampusLoop space</span>

                <h1>Student <span>dashboard.</span></h1>

                <p>Manage your profile and keep track of your campus marketplace activity.</p>
            </div>

            <a class="btn btn-primary" href="/add-listing">+ Create listing</a>
        </div>

        <!-- Welcome Panel -->
        <div class="welcome-panel">

            <div class="avatar avatar-large">
                <%= student.full_name.charAt(0).toUpperCase() %>
            </div>

            <div>
                <span class="small-muted">Welcome back,</span>

                <h2><%= student.full_name %></h2>

                <p>
                    <%= student.department %> · Student ID: <%= student.student_id %>
                </p>
            </div>

            <span class="demo-chip">Student account</span>

        </div>

        <!-- Student Profile Information -->
        <section class="content-panel" style="margin-top: 24px;">

            <div class="panel-heading">
                <h2>Your profile information</h2>
            </div>

            <div class="activity-row">
                <div class="activity-text">
                    <strong>Full name</strong>
                    <small><%= student.full_name %></small>
                </div>
            </div>

            <div class="activity-row">
                <div class="activity-text">
                    <strong>University email</strong>
                    <small><%= student.email %></small>
                </div>
            </div>

            <div class="activity-row">
                <div class="activity-text">
                    <strong>Student ID</strong>
                    <small><%= student.student_id %></small>
                </div>
            </div>

            <div class="activity-row">
                <div class="activity-text">
                    <strong>Department</strong>
                    <small><%= student.department %></small>
                </div>
            </div>

            <div class="activity-row">
                <div class="activity-text">
                    <strong>Joined CampusLoop</strong>
                    <small>
                        <%= new Date(student.created_at).toLocaleDateString('en-GB', {
                            day: 'numeric',
                            month: 'long',
                            year: 'numeric'
                        }) %>
                    </small>
                </div>
            </div>

        </section>

        <!-- Dashboard Statistics -->
        <div class="dashboard-stats">

            <article class="dashboard-stat">
                <span class="stat-icon">▣</span>
                <small>Active listings</small>
                <strong>0</strong>
                <span class="stat-caption">Your active items</span>
            </article>

            <article class="dashboard-stat">
                <span class="stat-icon">↔</span>
                <small>Active offers</small>
                <strong>0</strong>
                <span class="stat-caption">Offers to review</span>
            </article>

            <article class="dashboard-stat">
                <span class="stat-icon">✓</span>
                <small>Completed</small>
                <strong>0</strong>
                <span class="stat-caption">Successful transactions</span>
            </article>

            <article class="dashboard-stat">
                <span class="stat-icon">♻</span>
                <small>Items reused</small>
                <strong>0</strong>
                <span class="stat-caption">Items given a new home</span>
            </article>

        </div>

        <!-- Dashboard Content -->
        <div class="dashboard-columns">
         
            <!-- Recent Listings -->
            <section class="content-panel">

                <div class="panel-heading">
                    <h2>Recent listings</h2>

                    <a class="text-link" href="/marketplace">
                        Browse marketplace →
                    </a>
                </div>

                <% if (listings.length > 0) { %>

                    <% listings.forEach(listing => { %>

                        <div class="activity-row">

                            <% if (listing.image_path) { %>

                                <img
                                    src="<%= listing.image_path %>"
                                    alt="<%= listing.title %>"
                                    style="width: 65px; height: 65px; object-fit: cover; border-radius: 8px;"
                                >

                            <% } else { %>

                                <div
                                    style="width: 65px; height: 65px; display: flex; align-items: center; justify-content: center; background: #E8F3ED; border-radius: 8px; flex-shrink: 0;"
                                >
                                    <span style="font-size: 24px;">📦</span>
                                </div>

                            <% } %>

                            <div class="activity-text">

                                <strong><%= listing.title %></strong>

                                <small>
                                    <%= listing.category %> ·
                                    <%= listing.listing_type.charAt(0).toUpperCase() + listing.listing_type.slice(1) %>
                                </small>

                                <small>
                                    <% if (listing.price !== null) { %>
                                        PKR <%= Number(listing.price).toLocaleString('en-PK') %>
                                        ·
                                    <% } %>

                                    Status: <%= listing.status %>
                                </small>

                            </div>

                        </div>

                    <% }) %>

                <% } else { %>

                    <div class="activity-row">
                        <div class="activity-text">
                            <strong>No listings yet</strong>
                            <small>Your published items will appear here.</small>
                        </div>
                    </div>

                    <a class="btn btn-primary" href="/add-listing">
                        Create your first listing
                    </a>

                <% } %>

            </section>


            <!-- Transaction Activity -->
            <section class="content-panel">

                <div class="panel-heading">
                    <h2>Transaction activity</h2>
                    <span class="small-muted">Recent</span>
                </div>

                <div class="timeline-item">
                    <span class="timeline-dot"></span>

                    <div>
                        <strong>No transaction activity</strong>
                        <p>Your offers and completed transactions will appear here.</p>
                    </div>
                </div>

            </section>

        </div>

    </main>

    <!-- Footer -->
    <%- include('../partials/footer', { showTagline: false }) %>

</body>
</html>
