<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Listing | CampusLoop</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/navbar', { activePage: 'marketplace', showLogin: true, showSignup: false, showCreateListing: false }) %>
    <main class="container page-main narrow-main">
        <div class="page-heading compact-heading">
            <div>
                <span class="eyebrow">Manage your item</span>
                <h1>Edit <span>listing.</span></h1>
                <p>Update the information other students see in the marketplace.</p>
            </div>
        </div>

        <form class="listing-form" action="/my-listings/<%= listing.listing_id %>/edit"
              method="POST" enctype="multipart/form-data">
            <section class="form-section">
                <h2>Item details</h2>
                <div class="form-group">
                    <label for="itemTitle">Item title *</label>
                    <input id="itemTitle" name="itemTitle" type="text" maxlength="150" required value="<%= listing.title %>">
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="category">Category *</label>
                        <select id="category" name="category" required>
                            <% ['Books', 'Electronics', 'Study supplies', 'Hostel & home', 'Other'].forEach(value => { %>
                                <option value="<%= value %>" <%= listing.category === value ? 'selected' : '' %>><%= value %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="condition">Condition *</label>
                        <select id="condition" name="condition" required>
                            <% ['Like new', 'Good', 'Usable'].forEach(value => { %>
                                <option value="<%= value %>" <%= listing.condition === value ? 'selected' : '' %>><%= value %></option>
                            <% }) %>
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label for="description">Description *</label>
                    <textarea id="description" name="description" rows="5" maxlength="2000" required><%= listing.description %></textarea>
                </div>
            </section>

            <section class="form-section">
                <h2>Listing type and price</h2>
                <div class="form-row">
                    <div class="form-group">
                        <label for="listingType">Listing type *</label>
                        <select id="listingType" name="listingType" required>
                            <option value="sell" <%= listing.listing_type === 'sell' ? 'selected' : '' %>>For sale</option>
                            <option value="exchange" <%= listing.listing_type === 'exchange' ? 'selected' : '' %>>Exchange</option>
                            <option value="donate" <%= listing.listing_type === 'donate' ? 'selected' : '' %>>Donate / Free</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="price">Price (Rs.)</label>
                        <input id="price" name="price" type="number" min="0" step="0.01"
                               value="<%= listing.price === null ? '' : listing.price %>">
                    </div>
                </div>
            </section>

            <section class="form-section">
                <h2>Delivery information</h2>
                <div class="form-row">
                    <div class="form-group">
                        <label for="weightKg">Approximate weight (kg)</label>
                        <input id="weightKg" name="weightKg" type="number" min="0" step="0.01"
                               value="<%= listing.weight_kg === null ? '' : listing.weight_kg %>">
                    </div>
                    <div class="form-group">
                        <label for="itemSize">Item size</label>
                        <select id="itemSize" name="itemSize">
                            <option value="">Select size</option>
                            <% ['Small', 'Medium', 'Large', 'Extra large'].forEach(value => { %>
                                <option value="<%= value %>" <%= listing.item_size === value ? 'selected' : '' %>><%= value %></option>
                            <% }) %>
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label for="isFragile">Is the item fragile?</label>
                    <select id="isFragile" name="isFragile">
                        <option value="no" <%= !listing.is_fragile ? 'selected' : '' %>>No</option>
                        <option value="yes" <%= listing.is_fragile ? 'selected' : '' %>>Yes</option>
                    </select>
                </div>
            </section>

            <section class="form-section">
                <h2>Item image</h2>
                <% if (listing.image_path) { %>
                    <div class="current-listing-image">
                        <img src="<%= listing.image_path %>" alt="Current image of <%= listing.title %>">
                        <span>Current image</span>
                    </div>
                <% } %>
                <div class="form-group">
                    <label for="itemImage">Upload a replacement image (optional)</label>
                    <input id="itemImage" name="itemImage" type="file" accept="image/jpeg,image/png,image/webp">
                    <small class="small-muted">JPG, PNG or WEBP · Maximum 5 MB. Leave empty to keep the current image.</small>
                </div>
            </section>

            <div class="form-actions">
                <a class="btn btn-outline" href="/my-listings">Cancel</a>
                <button class="btn btn-primary" type="submit">Save changes</button>
            </div>
        </form>
    </main>
    <%- include('../partials/footer', { showTagline: true }) %>
    <script>
        const listingType = document.getElementById("listingType");
        const price = document.getElementById("price");
        function updatePriceAvailability() {
            const isForSale = listingType.value === "sell";
            price.disabled = !isForSale;
            if (!isForSale) price.value = "";
        }
        listingType.addEventListener("change", updatePriceAvailability);
        updatePriceAvailability();
    </script>
</body>
</html>
