
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create a listing | CampusLoop</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('../partials/navbar', {
        activePage: '',
        showLogin: true,
        showSignup: false,
        showCreateListing: false
    }) %>

    <main class="container page-main narrow-main">

        <div class="breadcrumb">
            <a href="/marketplace">Marketplace</a> / Create listing
        </div>

        <div class="page-heading compact-heading">
            <div>
                <span class="eyebrow">Pass it along</span>
                <h1>Create a <span>listing.</span></h1>
                <p>Share the details so another student can find what they need.</p>
            </div>
        </div>

        <form
            class="listing-form"
            action="/add-listing"
            method="POST"
            enctype="multipart/form-data"
        >

            <!-- Item Details -->
            <div class="form-section">
                <h2>Item details</h2>

                <div class="form-group">
                    <label for="item-title">Item title</label>
                    <input
                        id="item-title"
                        name="itemTitle"
                        type="text"
                        maxlength="150"
                        placeholder="e.g. Programming Fundamentals textbook"
                        required
                    >
                </div>

                <div class="form-row">

                    <div class="form-group">
                        <label for="item-category">Category</label>

                        <select id="item-category" name="category" required>
                            <option value="">Choose category</option>
                            <option value="Books">Books</option>
                            <option value="Electronics">Electronics</option>
                            <option value="Study supplies">Study supplies</option>
                            <option value="Hostel & home">Hostel & home</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="item-condition">Condition</label>

                        <select id="item-condition" name="condition" required>
                            <option value="">Choose condition</option>
                            <option value="Like new">Like new</option>
                            <option value="Good">Good</option>
                            <option value="Usable">Usable</option>
                        </select>
                    </div>

                </div>

                <div class="form-group">
                    <label for="item-description">Description</label>

                    <textarea
                        id="item-description"
                        name="description"
                        rows="4"
                        maxlength="2000"
                        placeholder="Describe the item's condition and any useful details..."
                        required
                    ></textarea>
                </div>

            </div>

            <!-- Listing Type and Price -->
            <div class="form-section">
                <h2>Listing type & price</h2>

                <div class="form-group">
                    <label for="listing-type">What would you like to do?</label>

                    <select id="listing-type" name="listingType" required>
                        <option value="">Select listing type</option>
                        <option value="sell">Sell</option>
                        <option value="exchange">Exchange</option>
                        <option value="donate">Donate</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="item-price">Price (PKR)</label>

                    <input
                        id="item-price"
                        name="price"
                        type="number"
                        min="0"
                        step="0.01"
                        placeholder="Enter amount (use 0 for free)"
                    >
                </div>

            </div>

            <!-- Item and Delivery Information -->
            <div class="form-section">
                <h2>Item & delivery information</h2>

                <p class="section-help">
                    These details can be used later by the Smart Delivery Recommendation feature.
                </p>

                <div class="form-row">

                    <div class="form-group">
                        <label for="item-weight">Approx. weight (kg)</label>

                        <input
                            id="item-weight"
                            name="weightKg"
                            type="number"
                            min="0"
                            step="0.1"
                            placeholder="e.g. 1.5"
                        >
                    </div>

                    <div class="form-group">
                        <label for="item-size">Size</label>

                        <select id="item-size" name="itemSize">
                            <option value="">Select size</option>
                            <option value="Small">Small</option>
                            <option value="Medium">Medium</option>
                            <option value="Large">Large</option>
                            <option value="Extra large">Extra large</option>
                        </select>
                    </div>

                </div>

                <div class="form-group">
                    <label for="item-fragile">Fragile item?</label>

                    <select id="item-fragile" name="isFragile">
                        <option value="no">No</option>
                        <option value="yes">Yes</option>
                    </select>
                </div>

            </div>

            <!-- Item Photo -->
            <div class="form-section">
                <h2>Item photo</h2>

                <label class="upload-area" for="item-image">

                    <span class="upload-icon">↑</span>

                    <strong>Choose an image</strong>

                    <small>Upload a photo of your item.</small>

                    <input
                        id="item-image"
                        name="itemImage"
                        type="file"
                        accept="image/jpeg,image/png,image/webp"
                    >

                </label>
            </div>

            <!-- Form Actions -->
            <div class="form-actions">

                <a class="btn btn-outline" href="/marketplace">
                    Cancel
                </a>

                <button class="btn btn-primary" type="submit">
                    Publish listing
                </button>

            </div>

        </form>

    </main>

    <%- include('../partials/footer', { showTagline: false }) %>

</body>
</html>
