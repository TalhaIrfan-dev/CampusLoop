
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product details | CampusLoop</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <%- include('../partials/navbar', {
        activePage: 'marketplace',
        showLogin: true,
        showSignup: false,
        showCreateListing: true
    }) %>

    <main class="container page-main">

        <!-- Breadcrumb -->
        <div class="breadcrumb">
            <a href="/marketplace">Marketplace</a>
            / Books / Programming Fundamentals
        </div>

        <!-- Product Details -->
        <div class="detail-layout">

            <div class="detail-image product-books">
                <div class="illustration-books">
                    <i></i>
                    <i></i>
                    <i></i>
                </div>
            </div>

            <section class="detail-info">

                <span class="product-category">BOOKS · FOR SALE</span>

                <h1>Programming Fundamentals</h1>

                <div class="detail-price">Rs. 1,200</div>

                <div class="detail-tags">
                    <span>Good condition</span>
                    <span>Available</span>
                </div>

                <p class="detail-description">
                    A useful textbook for introductory programming courses.
                    The pages are in good condition and it is ready for another
                    student to use.
                </p>

                <div class="detail-divider"></div>

                <h3>Seller information</h3>

                <div class="seller-profile">
                    <div class="avatar">A</div>

                    <div>
                        <strong>Ali Ahmed</strong>
                        <small>Computer Science · Student</small>
                    </div>

                    <span class="seller-verified">Student</span>
                </div>

                <div class="detail-actions">
                    <a class="btn btn-primary btn-large" href="/login">
                        Make an offer
                    </a>

                    <a class="btn btn-outline btn-large" href="/login">
                        Contact seller
                    </a>
                </div>

                <p class="small-muted">
                    Demo product content for the frontend preview.
                </p>

            </section>
        </div>
    </main>

    <%- include('../partials/footer', { showTagline: false }) %>
</body>
</html>
